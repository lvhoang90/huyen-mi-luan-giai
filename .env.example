ANTHROPIC_API_KEY=
# HUYENMY_MODEL=claude-sonnet-5-5
# PORT=5173
# Mã truy cập (đặt khi đưa lên mạng để người lạ không dùng hết lượt gọi AI; để trống = ai cũng vào được)
# HUYENMY_ACCESS_CODE=

# ---- Tài khoản, theo dõi và quản trị ----
# DATA_DIR=./data                 # nơi lưu SQLite; trên host hãy gắn ổ đĩa bền vững vào đây
# HUYENMY_ACCOUNTS=on             # off = không bắt đăng ký sau buổi đầu 30 phút
# ADMIN_EMAILS=ban@example.com    # các email được vào /admin (đăng nhập bằng mã gửi qua email)
# RESEND_API_KEY=                 # gửi email thật qua Resend; bỏ trống khi chạy thử thì mã được in ra console
# MAIL_FROM="Huyền My <no-reply@ten-mien-cua-ban>"
# HUYENMY_DATA_KEY=               # chuỗi bí mật dài, mã hóa cuộc trò chuyện đã đồng bộ (AES-256-GCM)
# HUYENMY_PEPPER=                 # chuỗi bí mật để băm mã xác nhận
# HUYENMY_DAILY_TURNS=200         # trần số lượt trả lời AI mỗi người mỗi ngày (chống tốn phí)
# TRUST_PROXY=1                   # đặt khi chạy sau nginx/Cloudflare để nhận đúng địa chỉ người dùng (xem docs/TRIEN-KHAI.md)
